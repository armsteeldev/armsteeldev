---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Personal portfolio / open archive</p>
        <h1 id="hero-title"><span>A place for the</span><span>random things I</span><span>make.</span></h1>
        <p class="hero__intro">Software, electronics, experiments, and whatever else I feel like building.</p>
        <div class="hero__actions">
          <a class="button button--filled" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
          <a class="button button--outline" href="/about/">About me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="hero-art__beam"></span>
        <span class="hero-art__fine-line"></span>
        <img class="hero-art__mark" src="/branding/armsteel-mark.svg" alt="" width="1473" height="1080" fetchpriority="high" />
        <span class="hero-art__caption">Armsteel / geometric mark</span>
      </div>
    </div>
    <div class="hero__baseline" aria-hidden="true"><span></span><span>01 — 04</span></div>
  </section>

  <section class="section work-section" id="projects" aria-labelledby="selected-work">
    <div class="container">
      <SectionHeading eyebrow="A small selection" title="Selected work" linkHref="/projects/" linkLabel="View all projects" />
      <div class="project-grid project-grid--featured">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="about-band" id="about" aria-labelledby="about-title">
    <div class="container about-band__inner">
      <div class="about-band__symbol" aria-hidden="true">
        <span class="about-band__slab"></span>
        <img src="/branding/armsteel-mark.svg" alt="" width="1473" height="1080" loading="lazy" />
      </div>
      <div class="about-band__heading">
        <p class="eyebrow">The person behind it</p>
        <h2 id="about-title">About</h2>
      </div>
      <div class="about-band__copy">
        <p>I’m Charlie Arnerstål — a maker, developer, and generalist engineer who likes building useful things and following a curiosity wherever it leads.</p>
        <a class="text-link" href="/about/">More about me <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="closing-note" aria-label="About Armsteel">
    <div class="container closing-note__inner">
      <p class="eyebrow">A note on Armsteel</p>
      <p class="closing-note__statement">One place for finished tools, half-formed ideas, and everything in between.</p>
      <a class="button button--outline" href="/projects/">Browse the archive <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
