---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 id="hero-title"><span>Things I’ve</span><span>built.</span></h1>
        <p class="hero__intro">I’m Charlie Arnerstål, the person behind Armsteel. I build software, explore systems, and experiment with electronics.</p>
        <div class="hero__actions">
          <a class="button button--filled" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
          <a class="button button--outline" href="/about/">About me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="hero-art__beam"></span>
        <span class="hero-art__fine-line"></span>
        <img class="hero-art__mark" src="/branding/armsteel-mark.svg" alt="" width="1473" height="1080" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section work-section" id="projects" aria-labelledby="selected-work">
    <div class="container">
      <SectionHeading eyebrow="Current projects" title="Selected work" linkHref="/projects/" linkLabel="View all projects" />
      <div class="project-grid project-grid--featured">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="about-band" id="about" aria-labelledby="about-title">
    <div class="container about-band__inner">
      <div class="about-band__symbol" aria-hidden="true">
        <span class="about-band__slab"></span>
        <img src="/branding/armsteel-mark.svg" alt="" width="1473" height="1080" loading="lazy" />
      </div>
      <div class="about-band__heading">
        <p class="eyebrow">The person behind it</p>
        <h2 id="about-title">About</h2>
      </div>
      <div class="about-band__copy">
        <p>I’m Charlie Arnerstål. Armsteel is where I collect software, technical projects, and the occasional electronics experiment.</p>
        <a class="text-link" href="/about/">More about me <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="closing-note" aria-label="About Armsteel">
    <div class="container closing-note__inner">
      <p class="eyebrow">The project archive</p>
      <p class="closing-note__statement">I keep this archive open as new things take shape.</p>
      <a class="button button--outline" href="/projects/">See all projects <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
