---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found — Armsteel" description="This page could not be found in the Armsteel archive." indexable={false}>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> 404 / Not found</p>
      <h1>This page is somewhere else.</h1>
      <p>It isn’t in the archive at this address.</p>
      <a class="button button--filled" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
