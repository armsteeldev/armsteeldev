---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(projects.map((project) => project.data.category))].sort((a, b) => a.localeCompare(b));
---

<SiteLayout title="Projects — Armsteel" description="Software, systems, and experiments made by Charlie Arnerstål.">
  <section class="page-intro archive-intro">
    <div class="container page-intro__inner">
      <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Projects</p>
      <h1>Projects, large and small.</h1>
      <p>Browse platforms, services, and experiments. Each project has room for the details that make it distinct.</p>
      <span class="page-intro__index" aria-hidden="true">{projects.length} PROJECTS</span>
    </div>
  </section>

  <section class="section archive-section" id="work-list" aria-labelledby="archive-title">
    <div class="container">
      <div class="archive-heading">
        <div>
          <p class="eyebrow">Browse by category</p>
          <h2 id="archive-title">The archive</h2>
        </div>
        <p class="archive-count">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
      </div>

      <div class="archive-filters" role="group" aria-label="Filter projects by category">
        <button class="filter-button" type="button" data-filter="all" aria-pressed="true" aria-controls="project-archive-grid">
          All projects <span>{projects.length}</span>
        </button>
        {categories.map((category) => (
          <button class="filter-button" type="button" data-filter={category.toLowerCase()} aria-pressed="false" aria-controls="project-archive-grid">
            {category} <span>{projects.filter((project) => project.data.category === category).length}</span>
          </button>
        ))}
      </div>

      <p class="filter-status" role="status" aria-live="polite">Showing all {projects.length} projects</p>
      <div class="project-grid archive-grid" id="project-archive-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="archive-empty" hidden>No projects match this category yet.</p>
    </div>
  </section>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-button')];
    const cards = [...document.querySelectorAll<HTMLElement>('.archive-grid .project-card')];
    const status = document.querySelector<HTMLElement>('.filter-status');
    const emptyMessage = document.querySelector<HTMLElement>('.archive-empty');

    function applyFilter(filter: string) {
      const activeButton = buttons.find((button) => button.dataset.filter === filter);
      if (!activeButton) return;

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button === activeButton));
      }

      let visible = 0;
      for (const card of cards) {
        const matches = filter === 'all' || card.dataset.category === filter;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      if (status) {
        const category = filter === 'all' ? '' : ` in ${activeButton.childNodes[0]?.textContent?.trim()}`;
        status.textContent = `Showing ${visible} ${visible === 1 ? 'project' : 'projects'}${category}`;
      }
      if (emptyMessage) emptyMessage.hidden = visible !== 0;
    }

    for (const button of buttons) {
      button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
    }

    const requestedCategory = new URLSearchParams(window.location.search).get('category')?.toLowerCase();
    if (requestedCategory && buttons.some((button) => button.dataset.filter === requestedCategory)) {
      applyFilter(requestedCategory);
    }
  </script>
</SiteLayout>
