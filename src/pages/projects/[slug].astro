---
import { getCollection, render } from 'astro:content';
import ProjectVisual from '../../components/ProjectVisual.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, year, images, links, githubUrl, technicalDetails } = project.data;
const projectLinks = [...links, ...(githubUrl ? [{ label: 'GitHub repository', url: githubUrl }] : [])];
---

<SiteLayout title={`${title} — Armsteel`} description={description}>
  <article class="project-detail">
    <header class="project-detail__intro">
      <div class="container project-detail__intro-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/projects/">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>
        <div class="project-detail__heading">
          <div class="project-detail__heading-copy">
            <p class="eyebrow"><span>{String(project.data.order).padStart(2, '0')}</span><span aria-hidden="true"> / </span>{category}</p>
            <h1>{title}</h1>
            <p class="project-detail__summary">{description}</p>
            {year && <p class="project-detail__year">{year}</p>}
            <p class="project-detail__credit">Presented in <a href="/about/">Charlie Arnerstål’s personal portfolio</a>.</p>
          </div>
          {projectLinks.length > 0 && (
            <nav class="project-detail__links" aria-label={`${title} links`}>
              {projectLinks.map((link) => (
                <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                  {link.label}<span aria-hidden="true">↗</span>
                </a>
              ))}
            </nav>
          )}
        </div>
      </div>
    </header>

    <div class="container project-detail__content">
      <ProjectVisual project={project} variant="detail" />

      <div class:list={["project-detail__main", technicalDetails.length === 0 && "project-detail__main--wide"]}>
        <div class="project-detail__prose prose"><Content /></div>

        {technicalDetails.length > 0 && (
          <aside class="project-detail__notes" aria-labelledby="project-notes-title">
            <h2 id="project-notes-title">Project notes</h2>
            <dl>
              {technicalDetails.map((detail) => (
                <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
              ))}
            </dl>
          </aside>
        )}
      </div>

      {images.length > 0 && (
        <div class="project-gallery" aria-label={`${title} images`}>
          {images.map((photo) => (
            <figure>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      <div class="project-detail__end">
        <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> Back to all projects</a>
      </div>
    </div>
  </article>
</SiteLayout>
