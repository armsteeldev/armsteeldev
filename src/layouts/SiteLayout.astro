---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  indexable?: boolean;
}

const {
  title = 'Armsteel — Charlie Arnerstål',
  description = 'The personal website of Charlie Arnerstål. Software, systems, electronics, and technical projects.',
  indexable = true,
} = Astro.props;
const canonical = indexable ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = new URL('/armsteel-charlie-og-v1.png', Astro.site).toString();
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://armsteel.dev/about/#charlie',
      name: 'Charlie Arnerstål',
      url: 'https://armsteel.dev/about/',
      sameAs: ['https://github.com/Charlemagne404'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://armsteel.dev/#website',
      url: 'https://armsteel.dev/',
      name: 'Armsteel',
      description: 'The personal portfolio of Charlie Arnerstål.',
      publisher: { '@id': 'https://armsteel.dev/about/#charlie' },
    },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e7e5e0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Armsteel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Armsteel and Charlie Arnerstål with the geometric Armsteel mark." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Armsteel and Charlie Arnerstål with the geometric Armsteel mark." />
    {indexable && <script type="application/ld+json" set:html={structuredData}></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
